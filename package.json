{
  "name": "markedit-quick-emoji",
  "version": "1.1.0",
  "description": "Converts emoticons into emoji as you type.",
  "scripts": {
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "reload": "osascript -e 'quit app \"MarkEdit\"' -e 'delay 1' -e 'launch app \"MarkEdit\"'",
    "uninstall": "rm ~/Library/Containers/app.cyan.markedit/Data/Documents/scripts/$(node -p \"require('./package.json').name\").js"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "emoticon": "^4.1.0"
  },
  "devDependencies": {
    "@lezer/markdown": "^1.0.0",
    "@types/node": "^22.0.0",
    "markedit-api": "https://github.com/MarkEdit-app/MarkEdit-api#v0.30.0",
    "markedit-vite": "https://github.com/MarkEdit-app/MarkEdit-vite#v0.5.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
